@import "colors.rasi"

configuration {
    font:                        "JetBrainsMono Nerd Font 11";
    show-icons:                  false;
    display-drun:                "";
    disable-history:             false;

    /* Escape (and Ctrl+g / Ctrl+[) closes rofi */
    kb-cancel:                   "Escape,Control+g,Control+bracketleft";

    /* Single left-click activates a row instead of select-then-Enter.
       me-select-entry must be cleared first or it conflicts. */
    me-select-entry:             "";
    me-accept-entry:             "MousePrimary";
}

window {
    width:                       520px;
    border-radius:               6px;
    background-color:            @surface;
    border:                      1px;
    border-color:                @primary;
    padding:                     0;
}

mainbox {
    children:                    [ inputbar, listview ];
    background-color:            transparent;
    padding:                     8px;
    spacing:                     8px;
}

inputbar {
    children:                    [ prompt, entry ];
    background-color:            transparent;
    padding:                     6px 10px;
    spacing:                     8px;
    border-radius:               6px;
}

prompt {
    background-color:            @primary;
    text-color:                  @on-primary;
    padding:                     4px 10px;
    border-radius:               6px;
}

entry {
    background-color:            transparent;
    text-color:                  @on-surface;
    placeholder:                 "Search…";
    placeholder-color:           @secondary;
    vertical-align:              0.5;
}

listview {
    lines:                       8;
    columns:                     1;
    fixed-height:                false;
    scrollbar:                   false;
    background-color:            transparent;
    spacing:                     2px;
}

element {
    padding:                     7px 10px;
    border-radius:               6px;
    background-color:            transparent;
    text-color:                  @on-surface;
}

element selected {
    background-color:            @primary;
    text-color:                  @on-primary;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
}
